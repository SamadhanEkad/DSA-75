    "n = 12121\n",
    "num = n\n",
    "rev = 0\n",
    "\n",
    "while num>0:\n",
    "    digit = num % 10\n",
    "    rev = rev * 10 + digit\n",
    "    num = num // 10\n",
    "\n",
    "if n == rev:\n",
    "    print(True)\n",
    "else:\n",
    "    print(False)"
