     "text": [
      "Armstrong Number\n"
     ]
    }
   ],
   "source": [
    "n = 153\n",
    "num = n\n",
    "sum = 0\n",
    "l = len(str(n))\n",
    "\n",
    "while num>0:\n",
    "    digit = num % 10\n",
    "    sum = sum + digit ** l\n",
    "    num = num // 10\n",
    "\n",
    "if n == sum:\n",
    "    print(\"Armstrong Number\")\n",
    "else:\n",
    "    print(\"Not An Armstrong Number\")"
   ]
  }
 ],
